# Starknet signer (required for transfers)
STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
STARKNET_ACCOUNT_ADDRESS=0x...
STARKNET_PRIVATE_KEY=0x...

# MCP server (build first: cd ../starknet-agentic && pnpm build)
TRANSFER_MCP_ENTRY=../starknet-agentic/packages/starknet-mcp-server/dist/index.js

# Transfer agent policy
TRANSFER_TOKEN=STRK
TRANSFER_RECIPIENT=0x...
TRANSFER_AMOUNT=0.1
# Only transfer when balance is strictly greater than this (human units)
MIN_BALANCE_TO_TRANSFER=1
# Log ALERT when balance is below this (human units)
ALERT_BALANCE_THRESHOLD=0.5

# 0 = dry-run only (simulate transfer, no tx). 1 = submit real transfer.
TRANSFER_EXECUTE=0

# Second step after balance/transfer: get_balances | call_contract
POST_ACTION=get_balances
# For call_contract — your deployed RestrictedToken address (optional)
# TOKEN_CONTRACT_ADDRESS=0x...

# Log output (JSONL, one object per run)
TRANSFER_LOG_FILE=./transfer-agent-log.jsonl

# Terminal notifications (boxed messages + optional bell on confirm/fail/alert)
# TERMINAL_NOTIFY=0   # disable boxed notifications
# TERMINAL_BELL=0     # disable terminal bell sound
